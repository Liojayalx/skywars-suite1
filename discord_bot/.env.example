# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_discord_bot_client_id

# Optional: Specific Discord Server/Guild ID for INSTANT slash command updates (avoids 1-hour Discord global cache)
GUILD_ID=

# Prefix for regular text channel commands (e.g. !whitelist, !ban, !status)
PREFIX=!

# Optional: Comma-separated Discord user IDs allowed to run commands (leave empty to allow server administrators)
ALLOWED_USER_IDS=

# GitHub Configuration for Cloud Sync
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=Liojayalx
GITHUB_REPO=skywars-suite1
GITHUB_BRANCH=main
GITHUB_CONFIG_PATH=access_config.json
